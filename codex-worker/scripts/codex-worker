#!/usr/bin/env python3
"""Launch, resume, and inspect foreground Codex CLI workers."""
import argparse
from contextlib import contextmanager
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import sys


class WorkerError(Exception):
    pass


def added_directories(directory, extra):
    return list(dict.fromkeys([str(directory)] + [str(Path(p).expanduser().resolve()) for p in extra]))


def safe_file(path):
    original = Path(path).expanduser()
    path = original.resolve()
    if any(part == '.env' or part.startswith('.env.') for part in original.parts + path.parts):
        raise WorkerError('.env files cannot be used as briefs or messages')
    return path


def write_meta(directory, meta):
    temporary = directory / 'meta.json.tmp'
    temporary.write_text(json.dumps(meta, indent=2) + '\n')
    temporary.replace(directory / 'meta.json')


@contextmanager
def run_lock(directory):
    # A thread must have only one writer. The OS releases this lock after crashes too.
    with (directory / '.worker.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise WorkerError('another worker is running in this directory') from exc
        try:
            yield
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)


def refuse_pending_children(meta, directory, thread):
    for run in meta['runs']:
        if run.get('exit_code') is not None or run.get('state') == 'lost':
            continue
        pid = run.get('pid')
        tag = run.get('tag') or '(untagged)'
        unknown = 'cannot verify whether run {} (PID {}) is still running; check it before resuming'.format(tag, pid)
        if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:
            raise WorkerError(unknown)
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            run['state'] = 'lost'
            write_meta(directory, meta)
            continue
        except PermissionError:
            pass  # ps can still establish identity; otherwise fail closed below.
        identity = run.get('last')
        if not isinstance(identity, str) or not identity:
            raise WorkerError(unknown)
        try:
            result = subprocess.run(['ps', '-o', 'command=', '-p', str(pid)],
                                    capture_output=True, text=True, timeout=10)
        except (OSError, subprocess.TimeoutExpired) as exc:
            raise WorkerError(unknown) from exc
        if result.returncode or not result.stdout.strip():
            raise WorkerError(unknown)
        if identity not in result.stdout:
            run['state'] = 'lost'
            write_meta(directory, meta)
            continue
        raise WorkerError('Codex child PID {} for thread {} is still running (run {}); '
                          'wait for it to exit, or stop that confirmed child with '
                          'kill -TERM {} before resuming'.format(pid, thread, tag, pid))


def launch(args, directory):
    meta_path = directory / 'meta.json'
    if args.command == 'start':
        if meta_path.exists() or (directory / 'thread_id').exists():
            raise WorkerError('directory already records a worker; use resume or a new directory')
        worktree = Path(args.worktree).expanduser().resolve()
        model, effort = args.model, args.effort
        network = args.network or 'off'
        sandbox = args.sandbox or 'workspace-write'
        meta = {'model': model, 'effort': effort, 'worktree': str(worktree),
                'network': network, 'sandbox': sandbox, 'runs': []}
        thread = None
        brief_path = args.brief or directory / 'brief.md'
    else:
        meta = json.loads(meta_path.read_text())
        thread = (directory / 'thread_id').read_text().strip()
        if not thread:
            raise WorkerError('thread_id is empty')
        refuse_pending_children(meta, directory, thread)
        worktree = Path(meta['worktree'])
        model, effort = args.model or meta['model'], args.effort or meta['effort']
        network = args.network or meta['network']
        sandbox = args.sandbox or meta.get('sandbox', 'workspace-write')
        brief_path = args.message
    if not worktree.is_dir():
        raise WorkerError('worktree is not a directory: {}'.format(worktree))
    brief = safe_file(brief_path).read_text()
    suffix = '-' + args.tag if args.tag else ''
    events = directory / ('events' + suffix + '.jsonl')
    stderr = directory / ('stderr' + suffix + '.log')
    last = directory / ('last' + suffix + '.md')
    if any(path.exists() for path in (events, stderr, last)):
        raise WorkerError('run output already exists; choose a new --tag')
    config = ['-c', 'model_reasoning_effort=' + effort]
    command = ['codex', 'exec']
    if sandbox == 'workspace-write':
        for path in added_directories(directory, args.writable):
            command += ['--add-dir', path]
        config += ['-c', 'sandbox_workspace_write.network_access=' + str(network == 'on').lower()]
    if args.command == 'resume':
        command += ['resume', thread, '-m', model, '-c', 'sandbox_mode=' + sandbox] + config
    else:
        command += ['-m', model, '-s', sandbox] + config + ['-C', str(worktree)]
    command += ['--skip-git-repo-check', '--json', '-o', str(last), '-']
    environment = os.environ.copy()
    for key, name in [('GOCACHE', 'gocache'), ('GOTMPDIR', 'gotmp'),
                      ('GOLANGCI_LINT_CACHE', 'golangci-lint-cache')]:
        if key not in environment:
            cache = directory / name
            cache.mkdir(exist_ok=True)
            environment[key] = str(cache)
    record = {'tag': args.tag, 'exit_code': None, 'model': model, 'effort': effort,
              'network': network, 'sandbox': sandbox, 'last': str(last)}
    meta['runs'].append(record)
    write_meta(directory, meta)
    code = 127
    try:
        with events.open('w') as output, stderr.open('w') as errors:
            # A file for stdin avoids deadlocks on large briefs and JSON event streams.
            import tempfile
            with tempfile.TemporaryFile(mode='w+') as input_file:
                input_file.write(brief)
                input_file.seek(0)
                process = subprocess.Popen(command, cwd=str(worktree), env=environment,
                                           stdin=input_file, stdout=subprocess.PIPE,
                                           stderr=errors, text=True)
                record['pid'] = process.pid
                write_meta(directory, meta)
                try:
                    for line in process.stdout:
                        output.write(line)
                        output.flush()
                        if thread is None:
                            try:
                                event = json.loads(line)
                            except ValueError:
                                continue
                            if isinstance(event, dict) and event.get('type') == 'thread.started' and event.get('thread_id'):
                                thread = str(event['thread_id'])
                                (directory / 'thread_id').write_text(thread + '\n')
                    code = process.wait()
                except BaseException:
                    process.terminate()
                    try:
                        process.wait(timeout=10)
                    except subprocess.TimeoutExpired:
                        process.kill()
                        process.wait()
                    code = 130
                    raise
    except OSError as exc:
        print('codex-worker: {}'.format(exc), file=sys.stderr)
    finally:
        code = 128 - code if code < 0 else code
        record['exit_code'] = code
        write_meta(directory, meta)
        print('codex exit={} thread={} last={}'.format(code, thread or 'unknown', last), flush=True)
    return code


def status(directory):
    meta = json.loads((directory / 'meta.json').read_text())
    thread_path = directory / 'thread_id'
    thread = thread_path.read_text().strip() if thread_path.exists() else 'unknown'
    print('thread={}'.format(thread))
    for run in meta['runs']:
        print('tag={} exit={}'.format(run['tag'] or '(untagged)',
                                     run['exit_code'] if run['exit_code'] is not None else 'pending')
              + (' state=lost' if run.get('state') == 'lost' else ''))
    result = subprocess.run(['ps', '-axo', 'pid=,command='], capture_output=True, text=True)
    if result.returncode:
        print('running=unknown (ps unavailable)')
    else:
        pids = {str(r['pid']) for r in meta['runs'] if r.get('exit_code') is None and r.get('state') != 'lost' and r.get('pid')}
        running = False
        for line in result.stdout.splitlines():
            fields = line.strip().split(None, 1)
            if len(fields) != 2:
                continue
            pid, command = fields
            is_codex = bool(re.search(r'(?:^|[/\s])codex(?:\s|$)', command))
            if is_codex and (pid in pids or (thread != 'unknown' and thread in command.split())):
                running = True
        print('running={} (ps observation)'.format('yes' if running else 'no'))
    lasts = list(directory.glob('last*.md'))
    newest = max(lasts, key=lambda p: p.stat().st_mtime_ns) if lasts else None
    print('last={}'.format(newest or '(none)'))
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='command', required=True)
    for name in ('start', 'resume', 'status'):
        command = sub.add_parser(name)
        command.add_argument('--dir', required=True, help='Worker state and output directory')
        if name == 'status':
            continue
        command.add_argument('--model', required=name == 'start')
        command.add_argument('--effort', required=name == 'start')
        command.add_argument('--sandbox', choices=('read-only', 'workspace-write'),
                             help='Start default: workspace-write; resume: recorded value')
        command.add_argument('--network', choices=('on', 'off'), help='Start default: off; resume: recorded value')
        command.add_argument('--writable', action='append', default=[], metavar='PATH')
        command.add_argument('--tag', help='Unique output suffix (letters, numbers, underscore, hyphen)')
        if name == 'start':
            command.add_argument('--worktree', required=True)
            command.add_argument('--brief', help='Default: DIR/brief.md; never an .env file')
        else:
            command.add_argument('--message', required=True, help='Message file; never an .env file')
    args = parser.parse_args(argv)
    if getattr(args, 'tag', None) and not re.fullmatch(r'[A-Za-z0-9_-]+', args.tag):
        parser.error('--tag must contain only letters, numbers, underscore or hyphen')
    if getattr(args, 'effort', None) and not re.fullmatch(r'[a-z]+', args.effort):
        parser.error('--effort must be a lowercase effort name')
    directory = Path(args.dir).expanduser().resolve()
    try:
        if args.command == 'status':
            return status(directory)
        directory.mkdir(parents=True, exist_ok=True)
        with run_lock(directory):
            return launch(args, directory)
    except (WorkerError, OSError, ValueError, KeyError) as exc:
        print('codex-worker: {}'.format(exc), file=sys.stderr)
        return 2


if __name__ == '__main__':
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)

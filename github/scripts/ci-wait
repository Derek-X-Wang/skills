#!/usr/bin/env python3
"""Wait for a fixed SHA or set of Actions runs without treating API errors as done."""
import argparse
import sys
import time
from urllib.parse import urlencode

from ci_common import GhError, gh_json, pages, repository


GOOD = {'success', 'skipped', 'neutral'}


def arguments(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    target = parser.add_mutually_exclusive_group(required=True)
    target.add_argument('--sha')
    target.add_argument('--pr', type=int)
    target.add_argument('--run', action='append', type=int, dest='runs')
    parser.add_argument('--repo')
    parser.add_argument('--interval', type=float, default=120, help='Seconds; minimum 60')
    parser.add_argument('--min-runs', type=int, default=1)
    parser.add_argument('--appear-timeout', type=float, default=900)
    parser.add_argument('--timeout', type=float, default=10800)
    args = parser.parse_args(argv)
    if args.interval < 60 or not args.interval < float('inf'):
        parser.error('--interval must be finite and at least 60 seconds')
    if args.min_runs < 1:
        parser.error('--min-runs must be at least 1')
    if any(not 0 < value < float('inf') for value in (args.appear_timeout, args.timeout)):
        parser.error('timeouts must be finite and positive')
    if (args.pr is not None and args.pr < 1) or any(n < 1 for n in args.runs or []):
        parser.error('PR and run IDs must be positive')
    return args


def summary(repo, runs):
    # Gather before printing: a failed jobs lookup must not produce a success result.
    lines = []
    for run in runs:
        lines.append('{}\t{}\t{}\t{}\t{}'.format(
            run['id'], run.get('name', ''), run.get('event', ''),
            run['conclusion'], run.get('html_url', '')))
        if run['conclusion'] != 'success':
            for job in pages(repo, 'runs/{}/jobs'.format(run['id']), 'jobs'):
                if job.get('conclusion') not in GOOD and job.get('conclusion') is not None:
                    step = next((s.get('name', '') for s in job.get('steps', [])
                                 if s.get('conclusion') == 'failure'), '(no failed step recorded)')
                    lines.append('  {}\t{}\t{}'.format(job.get('name', ''),
                                                        job.get('conclusion'), step))
    return lines


def wait(args):
    started = time.monotonic()
    delay = args.interval
    repo, sha = args.repo, args.sha
    appeared = False
    seen = {}
    while True:
        elapsed = time.monotonic() - started
        limit = args.timeout if appeared else min(args.timeout, args.appear_timeout)
        if elapsed >= limit:
            print('Timed out {}'.format('waiting for completion' if appeared else
                                        'waiting for runs to appear'), file=sys.stderr)
            return 3
        try:
            repo = repository(repo)
            if args.pr is not None and sha is None:
                response = gh_json('pr', 'view', str(args.pr), '--repo', repo, '--json', 'headRefOid')
                sha = response.get('headRefOid') if isinstance(response, dict) else None
                if not sha:
                    raise GhError('Missing PR head SHA in gh response')
            if args.runs:
                runs = [gh_json('api', 'repos/{}/actions/runs/{}'.format(repo, n))
                        for n in dict.fromkeys(args.runs)]
            else:
                runs = pages(repo, 'runs', 'workflow_runs', urlencode({'head_sha': sha}) + '&')
            if time.monotonic() - started >= limit:
                continue
            current = {}
            for run in runs:
                if not isinstance(run, dict) or not run.get('id') or not run.get('status'):
                    raise GhError('Missing run identity or status in gh response')
                seen.setdefault(run['id'], None)
                current[run['id']] = run
            if len(seen) >= args.min_runs:
                appeared = True
            # Listings can shrink while workflows rerun or GitHub updates its index.
            # Every observed ID remains part of this set, even after fetch errors.
            for identity in seen:
                if identity not in current:
                    run = gh_json('api', 'repos/{}/actions/runs/{}'.format(repo, identity))
                    if (not isinstance(run, dict) or run.get('id') != identity or not run.get('status')):
                        raise GhError('Missing or mismatched run {} in gh response'.format(identity))
                    current[identity] = run
            runs = [current[identity] for identity in seen]
            if len(runs) >= args.min_runs:
                appeared = True
                if all(r['status'] == 'completed' and r.get('conclusion') for r in runs):
                    lines = summary(repo, runs)
                    if time.monotonic() - started >= args.timeout:
                        print('Timed out waiting for completion', file=sys.stderr)
                        return 3
                    print('\n'.join(lines))
                    return 0 if all(r['conclusion'] in GOOD for r in runs) else 1
            delay = args.interval
        except GhError as exc:
            print('gh error: {}'.format(exc), file=sys.stderr)
            if exc.backoff:
                delay = min(delay * 2, 600)
        elapsed = time.monotonic() - started
        limit = args.timeout if appeared else min(args.timeout, args.appear_timeout)
        time.sleep(max(0, min(delay, limit - elapsed)))


def main(argv=None):
    return wait(arguments(argv))


if __name__ == '__main__':
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
